{
  "entities": {
    "users": {
      "title": "User",
      "description": "Perfil de usuario con roles (admin, empresa, cliente)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "empresa", "cliente"] },
        "companyId": { "type": "string" },
        "clientId": { "type": "string" },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "companies": {
      "title": "Company",
      "description": "Empresas registradas en el sistema",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "taxId": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name"]
    },
    "clients": {
      "title": "Client",
      "description": "Clientes de cada empresa",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "creditLimit": { "type": "number" },
        "creditDays": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["companyId", "name"]
    },
    "weighings": {
      "title": "Weighing Record",
      "description": "Registros de pesa de pollos y tickets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketNumber": { "type": "string" },
        "companyId": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "chickenCount": { "type": "number" },
        "grossWeight": { "type": "number" },
        "tareWeight": { "type": "number" },
        "netWeight": { "type": "number" },
        "unitPrice": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "pendingAmount": { "type": "number" },
        "paymentType": { "type": "string", "enum": ["contado", "credito"] },
        "paymentStatus": { "type": "string", "enum": ["pagado", "pendiente", "vencido", "parcial"] },
        "dueDate": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["companyId", "clientId", "chickenCount", "netWeight", "unitPrice", "totalAmount"]
    },
    "payments": {
      "title": "Payment Record",
      "description": "Abonos y pagos de clientes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "clientId": { "type": "string" },
        "weighingId": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "reference": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["companyId", "clientId", "amount"]
    },
    "inventory": {
      "title": "Inventory Item",
      "description": "Inventario de aves y lotes de granja",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "category": { "type": "string" },
        "name": { "type": "string" },
        "headCount": { "type": "number" },
        "totalWeight": { "type": "number" },
        "averageWeight": { "type": "number" },
        "unit": { "type": "string" },
        "minAlertThreshold": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["companyId", "name"]
    },
    "notifications": {
      "title": "Notification",
      "description": "Notificaciones en tiempo real para usuarios",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "targetUserId": { "type": "string" },
        "targetRole": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "message"]
    }
  }
}
